# 复制为同目录 .env 后填写（.env 已被 gitignore，禁止提交）
# 更推荐放到仓库外：%USERPROFILE%\.testcase-kb\.env
#
# 加载顺序（后者只补空缺，不覆盖已有 process.env / 先找到的值）：
#   1) KB_DOTENV_PATH（显式）
#   2) %USERPROFILE%\.testcase-kb\.env
#   3) skills/knowledge-base/config/.env   ← 本文件对应位置
#   4) src/config/.env
# Stage0 / KB Git / Confluence 下载侧共用此加载逻辑。

# ---------- GitLab（知识库 pull/push）----------
# GitLab 请用 Personal Access Token（或部署令牌），不要用登录密码明文
# （若公司策略允许密码再填 KB_GIT_PASSWORD）

KB_GIT_USERNAME=your.gitlab.username
KB_GIT_TOKEN=glpat-xxxxxxxxxxxxxxxx

# 可选：内网 KB Service
# KB_SERVICE_TOKEN=

# ---------- Confluence（Stage0/Stage1 下载需求页）----------
# 账号 + API Token（或公司允许时的登录密码）；禁止提交真实 .env
# Base URL 按你们实际站点改；金蝶知识库常见为 finkms

CONFLUENCE_BASE_URL=https://finkms.kingdee.com
CONFLUENCE_USERNAME=your.confluence.username
CONFLUENCE_API_TOKEN=your-api-token-or-password

# 可选别名：未设 CONFLUENCE_API_TOKEN 时可读密码字段
# CONFLUENCE_PASSWORD=
