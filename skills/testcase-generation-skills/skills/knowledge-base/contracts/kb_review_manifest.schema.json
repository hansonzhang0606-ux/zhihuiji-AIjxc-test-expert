{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testcase-generation.local/contracts/kb_review_manifest.schema.json",
  "title": "KbReviewManifest",
  "description": "Demand 6.3 评审工作区清单；内容审前不改语义库",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_id",
    "overview_id",
    "source_fingerprint",
    "base_commit",
    "changeset_hash",
    "selected_change_ids",
    "review_root",
    "files",
    "diff_path"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "6.3" },
    "review_id": { "type": "string", "minLength": 1 },
    "overview_id": { "type": "string", "minLength": 1 },
    "source_fingerprint": { "type": "string", "minLength": 8 },
    "base_commit": { "type": "string" },
    "changeset_hash": { "type": "string", "minLength": 8 },
    "created_at": { "type": "string", "format": "date-time" },
    "selected_change_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^CH-\\d{3,}$" },
      "uniqueItems": true
    },
    "review_root": {
      "type": "string",
      "description": "评审工作区绝对或相对路径；不得位于 kb_root"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_ref", "review_path"],
        "properties": {
          "target_ref": { "type": "string" },
          "review_path": { "type": "string" },
          "change_ids": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "diff_path": { "type": "string" },
    "content_confirmed": { "type": "boolean", "default": false },
    "completeness_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocking_gap_count", "warning_gap_count", "blocked_write"],
      "properties": {
        "blocking_gap_count": { "type": "integer", "minimum": 0 },
        "warning_gap_count": { "type": "integer", "minimum": 0 },
        "blocked_write": { "type": "boolean" },
        "report_hash": { "type": "string", "minLength": 8 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "blocking_gap_count": { "minimum": 1 } },
            "required": ["blocking_gap_count"]
          },
          "then": {
            "properties": { "blocked_write": { "const": true } }
          },
          "else": {
            "properties": { "blocked_write": { "const": false } }
          }
        }
      ]
    },
    "source_manifest": {
      "$ref": "https://testcase-generation.local/contracts/final_artifact.schema.json",
      "description": "Demand 6.4 可选：经校验的最终产物源清单快照"
    }
  }
}
