{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testcase-generation.local/contracts/test_cases.schema.json",
  "title": "TestCases",
  "description": "Demand 6.0 用例契约（FOUND-02 / C-TC）。路径：script/stage4/test_cases.json。主键 requirement_title；不使用故事编号。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requirement_title",
    "test_cases"
  ],
  "properties": {
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    },
    "schema_version": {
      "type": "string",
      "const": "6.0"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "quality_metrics": {
      "type": "object",
      "additionalProperties": false,
      "description": "可选：Stage4 质量度量快照",
      "properties": {
        "atomicity_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "completeness_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "step_expect_match_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "requirement_title": {
      "type": "string",
      "minLength": 1,
      "description": "需求文档 title（清洗后）"
    }
  },
  "$defs": {
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "productTag": {
      "type": "string",
      "enum": [
        "智慧记AI进销存",
        "ailit",
        "智慧记",
        "智慧记零售",
        "国际版"
      ]
    },
    "versionTag": {
      "type": "string",
      "enum": [
        "开单版",
        "单店版",
        "多店版"
      ]
    },
    "platformTag": {
      "type": "string",
      "enum": [
        "PC端",
        "APP端",
        "小程序端",
        "H5端"
      ]
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "module_l1",
        "product_tags",
        "version_tags",
        "platform_tags",
        "priority",
        "precondition",
        "steps",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TC-\\d{3,}$",
          "description": "如 TC-001"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "module_l1": {
          "type": "string",
          "minLength": 1
        },
        "module_l2": {
          "type": "string"
        },
        "product_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/productTag"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "version_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/versionTag"
          },
          "uniqueItems": true,
          "minItems": 0
        },
        "platform_tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/platformTag"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "precondition": {
          "type": "string",
          "minLength": 1,
          "description": "前置条件；无则写「无」"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          },
          "description": "每步必须有对应期望；用例原子、不依赖其他用例执行结果"
        },
        "source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^(RP|TP)-\\d{3,}$"
          },
          "description": "追溯 RP/TP id"
        },
        "technical_refs": {
          "type": "array",
          "description": "Demand 6.2/6.3 可选：仅允许从关联 C-TP 复制/裁剪",
          "items": { "$ref": "#/$defs/technicalRef" }
        }
      }
    },
    "technicalRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "platform", "page_id", "target", "kb_ref"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["page_url", "backend_api"]
        },
        "platform": {
          "type": "string",
          "enum": ["web", "app"]
        },
        "page_id": { "type": "string", "minLength": 1 },
        "element_name": { "type": "string" },
        "method": {
          "type": "string",
          "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "WS"]
        },
        "target": { "type": "string", "minLength": 1 },
        "operation": { "type": "string" },
        "kb_ref": { "type": "string", "minLength": 1 },
        "assertions": {
          "type": "array",
          "description": "Demand 6.4 可选：从关联 C-TP 深复制的字段级接口断言",
          "items": { "$ref": "#/$defs/apiAssertion" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "backend_api" } },
            "required": ["type"]
          },
          "then": {
            "required": ["element_name", "method"]
          }
        },
        {
          "if": {
            "required": ["assertions"]
          },
          "then": {
            "properties": { "type": { "const": "backend_api" } }
          }
        }
      ]
    },
    "apiAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "operator"],
      "properties": {
        "location": {
          "type": "string",
          "enum": ["status", "header", "body"]
        },
        "json_path": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "type": "string",
          "enum": ["eq", "contains", "not_contains", "exists", "not_exists", "unique"]
        },
        "expected": {
          "type": ["string", "number", "boolean", "null"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "location": { "const": "body" } },
            "required": ["location"]
          },
          "then": {
            "required": ["json_path"]
          }
        },
        {
          "if": {
            "properties": {
              "operator": {
                "enum": ["eq", "contains", "not_contains"]
              }
            },
            "required": ["operator"]
          },
          "then": {
            "required": ["expected"]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "action",
        "expected"
      ],
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "description": "操作步骤"
        },
        "expected": {
          "type": "string",
          "minLength": 1,
          "description": "该步期望结果"
        }
      }
    }
  }
}
