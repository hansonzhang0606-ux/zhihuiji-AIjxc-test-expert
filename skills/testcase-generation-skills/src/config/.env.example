# 复制为 src/config/.env 后填写；该文件已被 gitignore，禁止 git add
# 推荐优先使用：%USERPROFILE%\.testcase-kb\.env（完全不在仓库树内）
# 也可使用：skills/knowledge-base/config/.env（样例见同目录 .env.example）
#
# 与 skills/knowledge-base 共用 load_dotenv 加载顺序（后者只补空缺）。

# ---------- GitLab（知识库 pull/push）----------
KB_GIT_USERNAME=your.gitlab.username
KB_GIT_TOKEN=glpat-xxxxxxxxxxxxxxxx

# 可选
# KB_SERVICE_TOKEN=

# ---------- Confluence（Stage0/Stage1 下载需求页）----------
CONFLUENCE_BASE_URL=https://finkms.kingdee.com
CONFLUENCE_USERNAME=your.confluence.username
CONFLUENCE_API_TOKEN=your-api-token-or-password

# 可选别名：未设 CONFLUENCE_API_TOKEN 时可读
# CONFLUENCE_PASSWORD=
